# 作品の生成は AI を使わないので、API キーは不要。

# サーバーのポート
PORT=3000

# ---- 公開するときの設定 ----
# 次の 2 つは .env ではなく .env.production に書く（pnpm start と systemd のサービスだけが読む）。
# .env に書くと pnpm dev まで公開用の設定で動いてしまう。
#
#   PUBLIC_URL=https://art-sky.example.com     公開する URL。HTTPS が必須
#   COOKIE_SECRET=<16 文字以上のランダムな文字列>  Cookie 署名用の秘密鍵
#
# 開発（pnpm dev）ではどちらも不要。ループバッククライアントとして動き、
# Cookie の秘密鍵は最初の起動時に作って data/cookie-secret に保存する。

# 投稿時間帯の集計に使うタイムゾーン
TZ_NAME=Asia/Tokyo

# SQLite のファイル（省略時は data/art-sky.sqlite）
# DB_PATH=data/art-sky.sqlite

# ログイン後に戻す先（画面の URL）。ふつうは設定不要
# 省略時：PUBLIC_URL があればそれ。なければ http://127.0.0.1:5173（frontend の開発サーバー）
# FRONTEND_URL=http://127.0.0.1:5173

# Bluesky の投稿を監視する Jetstream の接続先（省略時は公開の jetstream2.us-east.bsky.network）
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# off にすると、生成したコードを Chromium で確かめずに保存する（Chromium を入れられない環境用）
# VALIDATE=off
