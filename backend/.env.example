# Claude API キー（https://platform.claude.com で発行）。作品の生成に必須
ANTHROPIC_API_KEY=
# 省略時は claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5
# 省略時は high（low | medium | high | xhigh | max）
# CLAUDE_EFFORT=high

# サーバーのポート
PORT=3000

# 本番で公開する URL（例: https://art-sky.example.com）。HTTPS が必須
# 空のままなら開発用のループバッククライアントとして動く（http://127.0.0.1:3000 で開く）
PUBLIC_URL=

# Cookie 署名用の秘密鍵（16 文字以上のランダムな文字列）
# 開発では空でよい（最初の起動時に作って data/cookie-secret に保存する）。PUBLIC_URL を設定したら必須
COOKIE_SECRET=

# 投稿時間帯の集計に使うタイムゾーン
TZ_NAME=Asia/Tokyo

# SQLite のファイル（省略時は data/art-sky.sqlite）
# DB_PATH=data/art-sky.sqlite

# ログイン後に戻す先（画面の URL）。ふつうは設定不要
# 省略時：PUBLIC_URL があればそれ。なければ http://127.0.0.1:5173（frontend の開発サーバー）
# FRONTEND_URL=http://127.0.0.1:5173

# Bluesky の投稿を監視する Jetstream の接続先（省略時は公開の jetstream2.us-east.bsky.network）
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# off にすると、生成したコードを Chromium で確かめずに保存する（Chromium を入れられない環境用）
# VALIDATE=off
