# サーバーのポートです
PORT=3000

# 本番で公開するURL（例: https://art-sky.example.com）
# 空のままなら開発用のループバッククライアントとして動く（http://127.0.0.1:3000 で開く）
PUBLIC_URL=

# Cookie 署名用の秘密鍵（16文字以上のランダムな文字列）
COOKIE_SECRET=change-me-to-a-long-random-string

# Claude API キー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=
# 省略時は claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5
# 省略時は high（low | medium | high | xhigh | max）
# CLAUDE_EFFORT=high

# 投稿時間帯の集計に使うタイムゾーン
TZ_NAME=Asia/Tokyo

# SQLite のファイル（省略時は data/art-sky.sqlite）
# DB_PATH=data/art-sky.sqlite

# ログイン後に戻す先（フロントエンド）
# FRONTEND_URL=http://127.0.0.1:5173
