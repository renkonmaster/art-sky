{
  "name": "@art-sky/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.production src/server.ts",
    "try:rules": "node scripts/try-rules.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "dev:service": "node --watch --env-file-if-exists=.env src/server.ts",
    "e2e": "node scripts/e2e-service.ts"
  },
  "dependencies": {
    "@art-sky/api": "workspace:*",
    "@art-sky/art": "workspace:*",
    "@art-sky/renderer": "workspace:*",
    "@atproto/api": "0.30.0",
    "@atproto/common-web": "0.5.17",
    "@atproto/oauth-client-node": "0.5.13",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
